{
  "allowManagedHooksOnly": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /app/argv-wacht.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I /app/web-jev.py",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
